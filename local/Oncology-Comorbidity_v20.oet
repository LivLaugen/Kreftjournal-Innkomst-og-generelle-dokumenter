    <definition archetype_id="openEHR-EHR-COMPOSITION.encounter.v1" xmlns:tem="openEHR/v1/Template" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="tem:COMPOSITION">
        <Content archetype_id="openEHR-EHR-SECTION.adhoc.v1" max="1" path="/content" template_id="1567272d-24af-44c7-9343-799225a4d276" xsi:type="tem:SECTION"/>
